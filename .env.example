# Backend API base URL (must include protocol, e.g. https://api.example.com)
VITE_APP_SERVER_BASE_URL=

# Razorpay public key
VITE_APP_RAZORPAY_KEY_ID=

# Console logging.
# Logs are ON automatically when running the dev server (`npm run dev`) and OFF
# in production builds. Set this to "true" to force them on in a deployed build
# (e.g. to debug on Vercel). Anything other than "true" leaves them off.
# `logger.error` always reports, regardless of this setting.
VITE_ENABLE_LOGS=
